# DRISHTI — environment variable reference
#
# Copy to `.env` for local work:  cp .env.example .env
# `.env` is gitignored (`.gitignore` line `/.env`). This file is committed and
# must never contain a real value. Every placeholder below is fake on purpose.
#
# Every variable the project reads — today or in a later task — is listed here.
# Task 28.6 will reconcile this file against the prose documentation.
#
# Status legend:
#   [LIVE]  read by code in this repo right now
#   [PLAN]  named in tasks.md / ROADMAP.md, not read yet; the module that will
#           read it is named so you can check the task that introduces it
#   [HOLD]  deliberately empty. Leave unset; the code must work without it
#
# There is no authentication in DRISHTI (docs/DECISIONS.md, D2). No variable
# here holds a user credential, and none ever should. The three marked SECRET
# are server-side keys only, injected by the platform (Cloud Run Secret
# Manager), never by a browser and never committed.


# ─────────────────────────────────────────────────────────────────────────────
# Frontend build — read by frontend/build.cjs during `npm run build`
# ─────────────────────────────────────────────────────────────────────────────

# [LIVE] HTTPS origin of the backend, baked into the generated dist/api-config.js.
# Must be an https origin with no path, no query, no credentials. Unset locally
# is fine: the build then points at http://localhost:8080 on localhost and
# disables hosted analysis elsewhere. This is public browser config, NOT a secret.
DRISHTI_API_BASE_URL=https://api.example.com

# [LIVE] Where `npm run build` writes the static site. Must be a child directory
# of frontend/ — the build refuses anything else. Unset means frontend/dist.
DRISHTI_BUILD_OUTPUT_DIR=

# [HOLD] Set by Cloudflare Pages itself to "true". Read only to decide whether to
# warn about an unset DRISHTI_API_BASE_URL. Do not set it by hand.
CF_PAGES=


# ─────────────────────────────────────────────────────────────────────────────
# Backend — read by backend/app/config.py
# ─────────────────────────────────────────────────────────────────────────────

# [LIVE] Comma-separated list of exact browser origins allowed to call the API.
# backend/app/config.py trims whitespace and trailing slashes and REJECTS "*" —
# an allowlist is the point. Unset falls back to the localhost defaults in
# config.py, so local work needs no value. Set this per environment on Cloud Run;
# changing it requires deploying a new revision. Not a secret.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500


# ─────────────────────────────────────────────────────────────────────────────
# Backend — planned (tasks.md Part 8: storage)
# ─────────────────────────────────────────────────────────────────────────────

# [LIVE] SQLAlchemy database URL, read by backend/app/config.py and handed to
# backend/app/storage/db.py. Unset -- and blank, which is what this file ships
# -- means a local SQLite file at backend/drishti.db (docs/DECISIONS.md D36).
# Accepted: a SQLite URL (sqlite:///drishti.db) or a PostgreSQL URL
# (postgresql://user@host/drishti; a driver may be named, postgresql+psycopg://).
# Checking the URL opens no connection, so a PostgreSQL value is accepted here
# whether or not its driver is installed. Anything else -- a backend this
# service does not ship, or a string that is not a URL -- is refused at start-up
# with a ValueError (D37). Leave it empty for local work; set it to override.
# Keep credentials out of the committed tree — a production value belongs in
# Secret Manager.
DATABASE_URL=


# ─────────────────────────────────────────────────────────────────────────────
# Backend — planned (tasks.md Parts 9 and 19: ledger, encrypted evidence)
# ─────────────────────────────────────────────────────────────────────────────

# [LIVE] SECRET. Ed25519 private key used to sign Merkle batch roots, read by
# backend/app/config.py (get_ledger_signing_key) and loaded by
# backend/app/ledger/signing.py (task 9.13). Unset -- and blank, which is what
# this file ships -- means a FRESH key is generated per call for local work.
# Nothing writes it anywhere, so a generated key makes every signature made
# under it unverifiable once the process restarts: set this before anchoring
# anything. The value must be an unencrypted Ed25519 private key in PEM PKCS#8
# and nothing else -- a public key, another curve, or a passphrase-protected
# key is refused by name at load. Generate a real one with:
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import \
#     Ed25519PrivateKey; from cryptography.hazmat.primitives import \
#     serialization; print(Ed25519PrivateKey.generate().private_bytes( \
#     serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, \
#     serialization.NoEncryption()).decode())"
# Losing it makes existing ledger signatures unverifiable. Rotating it breaks
# verification of every root signed with the old key.
LEDGER_SIGNING_KEY=

# [PLAN] SECRET. AES-GCM master key for the encrypted evidence store (task
# 19.1). A dev key is generated when absent. Base64, 32 bytes decoded — generate
# one with: python -c "import base64,os; \
#   print(base64.b64encode(os.urandom(32)).decode())"
# If this is lost, every stored evidence blob is unrecoverable. Task 19.1
# requires that a missing key never silently falls back to a known constant when
# the service is not in dev mode.
EVIDENCE_ENCRYPTION_KEY=

# [PLAN] Days before each record class is purged (task 19.7). Purge never touches
# ledger entries or the audit trail. An integer per record class, e.g. "screens=30".
RETENTION_DAYS=


# ─────────────────────────────────────────────────────────────────────────────
# Backend — planned (tasks.md Part 10, DECISIONS.md D2/D7: no auth, public demo)
# ─────────────────────────────────────────────────────────────────────────────

# [PLAN] Station identifier recorded as the `actor` on audit events and shown on
# the audit page (tasks 10.7 and 23.12). This is a configurable label, NOT a
# login and NOT an identity — it exists because there is no auth (D2). Defaults
# to a placeholder when unset. Never put a name, email, or credential here.
STATION_LABEL=

# [PLAN] true while the service is the unauthenticated public demo. Gates the
# expensive endpoints until rate limiting and a real key store exist (D7).
# Set to false on any deployment that holds real data.
PUBLIC_DEMO=true

# [PLAN] Per-IP request limit for the analysis endpoints, per minute (task 11.8).
# The (N+1)th request in a window is rejected with the standard error envelope.
# An integer. The public demo needs a small number so an open endpoint cannot
# become a denial-of-wallet.
RATE_LIMIT_PER_MINUTE=


# ─────────────────────────────────────────────────────────────────────────────
# Backend — planned (tasks.md Part 12: Tier 1 OCR)
# ─────────────────────────────────────────────────────────────────────────────

# [PLAN] Float in [0,1]. OCR word confidence below this triggers one re-read at
# higher DPI, then the fallback engine, and only then a low-confidence flag
# (task 12.9). This is the anti-false-alarm gate; raising it makes the service
# more suspicious, lowering it makes it more permissive.
OCR_CONFIDENCE_THRESHOLD=


# ─────────────────────────────────────────────────────────────────────────────
# Backend — planned (tasks.md Part 14: deep audit sampler)
# ─────────────────────────────────────────────────────────────────────────────

# [PLAN] SECRET. HMAC key for the randomised deep-audit draw (task 14.8). The
# draw is HMAC(AUDIT_DRAW_SECRET, screening_id) < DEEP_AUDIT_RATE: unpredictable
# to the officer, reproducible for audit. Same id must always draw the same
# outcome, so never rotate this without accepting that already-drawn screenings
# change. Generate a dev value with: python -c "import secrets; \
#   print(secrets.token_hex(32))"
AUDIT_DRAW_SECRET=

# [PLAN] Probability in [0,1] that a screening is selected for deep audit (task
# 14.8). 0 disables deep audit; 1 audits everything.
DEEP_AUDIT_RATE=


# ─────────────────────────────────────────────────────────────────────────────
# Backend — planned (tasks.md Part 17: self-hosted summariser)
# ─────────────────────────────────────────────────────────────────────────────

# [PLAN] Master switch for the LLM summariser. Must be false for the client to
# stay uncalled (task 17.8) — the default is the safe answer, so leave it unset
# or set it to false until a local model is actually running. The rule-based
# template summariser (task 17.2) is used whenever this is false.
LOCAL_LLM_ENABLED=false

# [PLAN] Base URL of the local Ollama / llama.cpp HTTP API (task 17.7). There is
# NO external fallback by design: no request may leave this host, so it must be
# a loopback or LAN address, never a public API endpoint.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434

# [PLAN] Model name to request from the local server (task 17.7). Whatever
# `ollama list` reports.
LOCAL_LLM_MODEL=

# [PLAN] Hard timeout in seconds for the summariser request (task 17.7). On
# timeout the client returns None and the template summary is used — it must
# never raise.
LOCAL_LLM_TIMEOUT_SECONDS=
